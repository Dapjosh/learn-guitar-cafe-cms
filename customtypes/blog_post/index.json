{
  "format": "page",
  "id": "blog_post",
  "label": "Blog Post",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID",
          "placeholder": ""
        },
        "type": "UID"
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": ""
        }
      },
      "category": {
        "type": "Link",
        "config": {
          "label": "Category",
          "select": "document",
          "customtypes": [
            "blog_category"
          ]
        }
      },
      "publishing_date": {
        "type": "Date",
        "config": {
          "label": "Publishing Date",
          "placeholder": ""
        }
      },
      "feature_image": {
        "type": "Image",
        "config": {
          "label": "Feature Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "author": {
        "type": "Link",
        "config": {
          "label": "Author",
          "select": "document",
          "customtypes": [
            "author"
          ]
        }
      },
      "description": {
        "type": "Text",
        "config": {
          "label": "Description ",
          "placeholder": ""
        }
      },
      "read_time": {
        "type": "Number",
        "config": {
          "label": "Read Time in Minutes (optional - estimated from the body if empty)",
          "placeholder": "6"
        }
      },
      "main": {
        "type": "StructuredText",
        "config": {
          "label": "Body",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
        }
      },
      "tags": {
        "type": "Group",
        "config": {
          "label": "Tags",
          "repeat": true,
          "fields": {
            "tag": {
              "type": "Link",
              "config": {
                "label": "tag",
                "select": "document",
                "customtypes": [
                  "blog_tags"
                ]
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "rich_text_slice": {
              "type": "SharedSlice"
            },
            "faqs": {
              "type": "SharedSlice"
            },
            "call_to_action": {
              "type": "SharedSlice"
            },
            "media_study_card": {
              "type": "SharedSlice"
            },
            "image_block": {
              "type": "SharedSlice"
            },
            "video_playlist": {
              "type": "SharedSlice"
            },
            "author_bio": {
              "type": "SharedSlice"
            },
            "content_image_slice": {
              "type": "SharedSlice"
            },
            "section_headers": {
              "type": "SharedSlice"
            },
            "stats_band": {
              "type": "SharedSlice"
            },
            "testimonials": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "keywords": {
        "type": "Group",
        "config": {
          "label": "Keywords",
          "repeat": true,
          "fields": {
            "word": {
              "type": "Text",
              "config": {
                "label": "word",
                "placeholder": ""
              }
            }
          }
        }
      },
      "slices1": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {}
        }
      }
    },
    "Design": {
      "page_bg_color": {
        "type": "Color",
        "config": {
          "label": "Page Background Color (header area - empty = Blog default)",
          "placeholder": ""
        }
      },
      "page_bg_image": {
        "type": "Image",
        "config": {
          "label": "Page Background Image / Texture (optional)",
          "constraint": {},
          "thumbnails": []
        }
      },
      "content_bg_color": {
        "type": "Color",
        "config": {
          "label": "Content Background Color (article body - empty = Blog default)",
          "placeholder": ""
        }
      },
      "featured_image_display": {
        "type": "Select",
        "config": {
          "label": "Featured Image",
          "placeholder": "",
          "default_value": "Default",
          "options": [
            "Default",
            "Wide",
            "Contained",
            "Full width",
            "Hidden"
          ]
        }
      },
      "featured_image_aspect": {
        "type": "Select",
        "config": {
          "label": "Featured Image Shape",
          "placeholder": "",
          "default_value": "Default",
          "options": [
            "Default",
            "Landscape",
            "Wide",
            "Original"
          ]
        }
      }
    }
  }
}

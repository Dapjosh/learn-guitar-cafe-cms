{
  "format": "custom",
  "id": "course",
  "label": "Course",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": ""
        }
      },
      "course_image": {
        "type": "Image",
        "config": {
          "label": "Course Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "summary": {
        "type": "StructuredText",
        "config": {
          "label": "Summary",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
        }
      },
      "course_category": {
        "type": "Link",
        "config": {
          "label": "Course Category",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "course_category",
              "fields": [
                "name"
              ]
            }
          ]
        }
      },
      "author": {
        "type": "Text",
        "config": {
          "label": "author",
          "placeholder": ""
        }
      },
      "duration": {
        "type": "Text",
        "config": {
          "label": "duration",
          "placeholder": ""
        }
      },
      "student_count": {
        "type": "Number",
        "config": {
          "label": "student_count",
          "placeholder": ""
        }
      },
      "original_price": {
        "type": "Number",
        "config": {
          "label": "original_price",
          "placeholder": ""
        }
      },
      "current_price": {
        "type": "Number",
        "config": {
          "label": "current_price",
          "placeholder": ""
        }
      }
    },
    "Catalog": {
      "tags": {
        "type": "Group",
        "config": {
          "label": "Tags (shown as pills, e.g. Beginner, Open E)",
          "repeat": true,
          "fields": {
            "tag": {
              "type": "Text",
              "config": {
                "label": "Tag",
                "placeholder": "Beginner"
              }
            }
          }
        }
      },
      "card_description": {
        "type": "Text",
        "config": {
          "label": "Short Description (cards & lists - leave empty to use the Summary)",
          "placeholder": "Open E slide from first notes to full songs."
        }
      },
      "features": {
        "type": "Group",
        "config": {
          "label": "Features (shown in the course list)",
          "repeat": true,
          "fields": {
            "icon": {
              "type": "Select",
              "config": {
                "label": "Icon",
                "placeholder": "",
                "default_value": "Video",
                "options": [
                  "Video",
                  "TABs",
                  "Backing tracks",
                  "PDF",
                  "Check",
                  "Music"
                ]
              }
            },
            "label": {
              "type": "Text",
              "config": {
                "label": "Label",
                "placeholder": "Step-by-step video lessons"
              }
            }
          }
        }
      },
      "meta_line": {
        "type": "Text",
        "config": {
          "label": "Meta Line (shown on course cards)",
          "placeholder": "Video · TABs · Tracks"
        }
      },
      "display_order": {
        "type": "Number",
        "config": {
          "label": "Display Order (lower numbers show first)",
          "placeholder": "1"
        }
      },
      "course_link": {
        "type": "Link",
        "config": {
          "label": "View Course Link (optional - defaults to /courses/<uid>)",
          "select": null,
          "allowTargetBlank": true
        }
      }
    }
  }
}

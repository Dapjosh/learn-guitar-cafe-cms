{
  "format": "custom",
  "id": "navigation",
  "label": "Navigation",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "links": {
        "type": "Group",
        "config": {
          "label": "Links",
          "repeat": true,
          "fields": {
            "label": {
              "type": "StructuredText",
              "config": {
                "label": "Label",
                "placeholder": "",
                "allowTargetBlank": true,
                "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "placeholder": "",
                "select": null
              }
            }
          }
        }
      },
      "login_label": {
        "type": "Text",
        "config": {
          "label": "Login Button Label",
          "placeholder": "Login"
        }
      },
      "login_link": {
        "type": "Link",
        "config": {
          "label": "Login Button Link",
          "placeholder": "/sign-in",
          "select": null
        }
      },
      "cta_label": {
        "type": "Text",
        "config": {
          "label": "CTA Button Label",
          "placeholder": "Free starter pack"
        }
      },
      "cta_link": {
        "type": "Link",
        "config": {
          "label": "CTA Button Link",
          "placeholder": "/sign-up",
          "select": null
        }
      },
      "navbar_height": {
        "type": "Number",
        "config": {
          "label": "Navbar Height (px)",
          "placeholder": "90"
        }
      },
      "navbar_bg_color": {
        "type": "Color",
        "config": {
          "label": "Navbar Background Color",
          "placeholder": "#f4eee5"
        }
      },
      "site_name_font": {
        "type": "Select",
        "config": {
          "label": "Site Name Font",
          "placeholder": "",
          "default_value": "Inter",
          "options": [
            "Inter",
            "Raleway",
            "Nunito",
            "Mochiy Pop One",
            "Anton"
          ]
        }
      },
      "menu_font": {
        "type": "Select",
        "config": {
          "label": "Menu Links Font",
          "placeholder": "",
          "default_value": "Raleway",
          "options": [
            "Raleway",
            "Inter",
            "Nunito",
            "Mochiy Pop One",
            "Anton"
          ]
        }
      },
      "button_font": {
        "type": "Select",
        "config": {
          "label": "Buttons Font",
          "placeholder": "",
          "default_value": "Inter",
          "options": [
            "Inter",
            "Raleway",
            "Nunito",
            "Mochiy Pop One",
            "Anton"
          ]
        }
      },
      "button_radius": {
        "type": "Select",
        "config": {
          "label": "Buttons Border Radius",
          "placeholder": "",
          "default_value": "Rounded (Medium)",
          "options": [
            "Rounded (Medium)",
            "Slightly Rounded (Small)",
            "Large Rounded",
            "Pill (Full)",
            "Sharp (Square)"
          ]
        }
      }
    }
  }
}
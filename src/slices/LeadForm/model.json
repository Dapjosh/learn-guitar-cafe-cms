{
  "id": "lead_form",
  "type": "SharedSlice",
  "name": "LeadForm",
  "description": "Sign-up form (name + email) that adds people to a MailerLite group, with optional thank-you page",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Sign-up card",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": "Send me the free lesson"
          }
        },
        "title_font": {
          "type": "Select",
          "config": {
            "label": "Title Font",
            "placeholder": "",
            "default_value": "Fraunces",
            "options": [
              "Fraunces",
              "Inter Tight",
              "Bebas Neue",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "description": {
          "type": "Text",
          "config": {
            "label": "Intro",
            "placeholder": "Enter your details and I'll email the video, TABs and backing track straight away."
          }
        },
        "show_name_field": {
          "type": "Boolean",
          "config": {
            "label": "Ask for Name",
            "default_value": true,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        },
        "name_required": {
          "type": "Boolean",
          "config": {
            "label": "Name Required",
            "default_value": false,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        },
        "name_label": {
          "type": "Text",
          "config": {
            "label": "Name Label",
            "placeholder": "Your name"
          }
        },
        "name_placeholder": {
          "type": "Text",
          "config": {
            "label": "Name Placeholder",
            "placeholder": "First name"
          }
        },
        "email_label": {
          "type": "Text",
          "config": {
            "label": "Email Label",
            "placeholder": "Your email address"
          }
        },
        "email_placeholder": {
          "type": "Text",
          "config": {
            "label": "Email Placeholder",
            "placeholder": "you@example.com"
          }
        },
        "button_label": {
          "type": "Text",
          "config": {
            "label": "Button Label",
            "placeholder": "Send my free lesson"
          }
        },
        "fine_print": {
          "type": "Text",
          "config": {
            "label": "Fine Print",
            "placeholder": "Free, no card needed. You'll also get my acoustic roots newsletter, and you can unsubscribe anytime."
          }
        },
        "mailerlite_group_id": {
          "type": "Text",
          "config": {
            "label": "MailerLite Group ID (subscribers are added here; trigger your lesson email from this group)",
            "placeholder": ""
          }
        },
        "success_message": {
          "type": "Text",
          "config": {
            "label": "Success Message",
            "placeholder": "Thanks! Check your inbox: the lesson is on its way."
          }
        },
        "success_redirect": {
          "type": "Link",
          "config": {
            "label": "Thank-you Page (optional - redirect after signing up)",
            "placeholder": "",
            "select": null,
            "allowTargetBlank": true
          }
        },
        "anchor_id": {
          "type": "Text",
          "config": {
            "label": "Section ID (for links, default 'get-the-lesson')",
            "placeholder": ""
          }
        },
        "show_card": {
          "type": "Boolean",
          "config": {
            "label": "Show Card Around the Form",
            "default_value": true,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        },
        "width": {
          "type": "Select",
          "config": {
            "label": "Card Width",
            "placeholder": "",
            "default_value": "Medium",
            "options": [
              "Medium",
              "Narrow",
              "Wide"
            ]
          }
        },
        "alignment": {
          "type": "Select",
          "config": {
            "label": "Card Alignment",
            "placeholder": "",
            "default_value": "Center",
            "options": [
              "Center",
              "Left",
              "Right"
            ]
          }
        },
        "section_bg_color": {
          "type": "Color",
          "config": {
            "label": "Section Background",
            "placeholder": "#f3efe6"
          }
        },
        "card_bg_color": {
          "type": "Color",
          "config": {
            "label": "Card Background",
            "placeholder": "#fbf9f5"
          }
        },
        "card_border_color": {
          "type": "Color",
          "config": {
            "label": "Card Border",
            "placeholder": "#e7dfd2"
          }
        },
        "title_color": {
          "type": "Color",
          "config": {
            "label": "Title Color",
            "placeholder": "#1c1917"
          }
        },
        "text_color": {
          "type": "Color",
          "config": {
            "label": "Intro / Fine Print Color",
            "placeholder": "#78716c"
          }
        },
        "label_color": {
          "type": "Color",
          "config": {
            "label": "Field Label Color",
            "placeholder": "#1c1917"
          }
        },
        "input_bg_color": {
          "type": "Color",
          "config": {
            "label": "Field Background",
            "placeholder": "#fbf9f5"
          }
        },
        "input_border_color": {
          "type": "Color",
          "config": {
            "label": "Field Border",
            "placeholder": "#e2d9cb"
          }
        },
        "input_text_color": {
          "type": "Color",
          "config": {
            "label": "Field Text",
            "placeholder": "#1c1917"
          }
        },
        "button_bg_color": {
          "type": "Color",
          "config": {
            "label": "Button Background",
            "placeholder": "#d85d18"
          }
        },
        "button_text_color": {
          "type": "Color",
          "config": {
            "label": "Button Text",
            "placeholder": "#ffffff"
          }
        },
        "button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Button Hover Background",
            "placeholder": "#b94c10"
          }
        },
        "button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Button Hover Text",
            "placeholder": "#ffffff"
          }
        },
        "padding_top": {
          "type": "Select",
          "config": {
            "label": "Space Above",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_bottom": {
          "type": "Select",
          "config": {
            "label": "Space Below",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_top_custom": {
          "type": "Number",
          "config": {
            "label": "Space Above in px (optional)",
            "placeholder": ""
          }
        },
        "padding_bottom_custom": {
          "type": "Number",
          "config": {
            "label": "Space Below in px (optional)",
            "placeholder": ""
          }
        }
      },
      "items": {}
    }
  ]
}

			"bio": {
				"__TYPE__": "StructuredTextContent",
				"value": [
					{
						"type": "paragraph",
						"content": {
							"text": "I'm Paul Greig, a guitarist with more than 20 years as a live performer and session musician in Australia. I grew up in Tamworth, Australia's country music capital, and fell for the guitar as a teenager.",
							"spans": []
						}
					},
					{
						"type": "paragraph",
						"content": {
							"text": "I went on to complete a degree in contemporary music, majoring in guitar and composition, and studied with musicians including Jeff “Skunk” Baxter of Steely Dan and The Doobie Brothers.",
							"spans": []
						}
					}
				]
			},

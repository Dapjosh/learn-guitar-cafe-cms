			"title": {
				"__TYPE__": "StructuredTextContent",
				"value": [
					{
						"type": "heading2",
						"content": {
							"text": "THE STORY BEHIND LEARN GUITAR CAFE",
							"spans": []
						}
					}
				]
			},
			"left_text": {
				"__TYPE__": "StructuredTextContent",
				"value": [
					{
						"type": "paragraph",
						"content": {
							"text": "Learning to play should feel as natural as listening to your favourite record. Learn Guitar Cafe started with a simple aim: make traditional slide and roots guitar easy to follow, with a structured, jargon-free path for players who want real tone, feel and the freedom to improvise, without getting stuck in endless scales.",
							"spans": []
						}
					},
					{
						"type": "paragraph",
						"content": {
							"text": "What began as a passion for teaching bottleneck slide grew into a complete course. Each masterclass keeps the feel of analog roots music and breaks it into clear, step-by-step lessons you can work through at home, at your own pace.",
							"spans": []
						}
					},
					{
						"type": "paragraph",
						"content": {
							"text": "Today the Cafe is a community of players from around the world who share a love of blues, slide and authentic tone. The approach stays hands-on and practical, focused on getting you playing the music you love.",
							"spans": []
						}
					}
				]
			},
			"right_intro": {
				"__TYPE__": "StructuredTextContent",
				"value": [
					{
						"type": "paragraph",
						"content": {
							"text": "Every lesson is built around playing, so you hear your progress from the first week:",
							"spans": []
						}
					}
				]
			},
			"points": {

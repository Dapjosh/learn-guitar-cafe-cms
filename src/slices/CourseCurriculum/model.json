{
  "id": "course_curriculum",
  "type": "SharedSlice",
  "name": "CourseCurriculum",
  "description": "Bento grid curriculum layout showcasing courses linked from the Course custom type with index numbers, vintage badges, and configurable header.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default Course Curriculum Grid",
      "imageUrl": "",
      "primary": {
        "badge_icon": {
          "type": "Image",
          "config": {
            "label": "Badge Icon (Upload Icon Image)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "badge_text": {
          "type": "Text",
          "config": {
            "label": "Badge Text",
            "placeholder": "Core curriculum"
          }
        },
        "badge_bg_color": {
          "type": "Color",
          "config": {
            "label": "Badge Background Color",
            "placeholder": "rgba(255, 255, 255, 0.1)"
          }
        },
        "badge_color": {
          "type": "Color",
          "config": {
            "label": "Badge Text & Icon Color",
            "placeholder": "#ffffff"
          }
        },
        "badge_border_color": {
          "type": "Color",
          "config": {
            "label": "Badge Border Color",
            "placeholder": "rgba(255, 255, 255, 0.15)"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "single": "heading2,heading1,strong,em",
            "label": "Heading Title"
          }
        },
        "title_font": {
          "type": "Select",
          "config": {
            "label": "Heading Font",
            "placeholder": "",
            "default_value": "Bebas Neue",
            "options": [
              "Bebas Neue",
              "Fraunces",
              "Inter Tight",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "title_size": {
          "type": "Select",
          "config": {
            "label": "Heading Size",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "Extra Large",
              "Medium",
              "Small"
            ]
          }
        },
        "title_color": {
          "type": "Color",
          "config": {
            "label": "Heading Color",
            "placeholder": "#ffffff"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "single": "paragraph,preformatted,strong,em,hyperlink",
            "label": "Description / Subtitle"
          }
        },
        "description_font": {
          "type": "Select",
          "config": {
            "label": "Description Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Fraunces",
              "Bebas Neue",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "description_color": {
          "type": "Color",
          "config": {
            "label": "Description Color",
            "placeholder": "#a8a29e"
          }
        },
        "button_text": {
          "type": "Text",
          "config": {
            "label": "Button Label",
            "placeholder": "Discover the courses"
          }
        },
        "button_link": {
          "type": "Link",
          "config": {
            "label": "Button Link",
            "placeholder": "/courses",
            "select": null
          }
        },
        "button_bg_color": {
          "type": "Color",
          "config": {
            "label": "Button Background Color",
            "placeholder": "#f5f5f4"
          }
        },
        "button_text_color": {
          "type": "Color",
          "config": {
            "label": "Button Text Color",
            "placeholder": "#1c1917"
          }
        },
        "button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Button Hover Background Color",
            "placeholder": "#ffffff"
          }
        },
        "button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Button Hover Text Color",
            "placeholder": "#000000"
          }
        },
        "section_bg_color": {
          "type": "Color",
          "config": {
            "label": "Section Background Color",
            "placeholder": "#191614"
          }
        },
        "card_bg_color": {
          "type": "Color",
          "config": {
            "label": "Card Grid Background Color",
            "placeholder": "#211c19"
          }
        },
        "border_color": {
          "type": "Color",
          "config": {
            "label": "Grid Border Color",
            "placeholder": "rgba(255, 255, 255, 0.1)"
          }
        },
        "number_color": {
          "type": "Color",
          "config": {
            "label": "Number Color",
            "placeholder": "#d85d18"
          }
        },
        "card_title_font": {
          "type": "Select",
          "config": {
            "label": "Card Title Font",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Fraunces",
              "Bebas Neue",
              "Raleway",
              "Inter",
              "Nunito",
              "Anton"
            ]
          }
        }
      },
      "items": {
        "course": {
          "type": "Link",
          "config": {
            "label": "Course (Select from Courses Roll)",
            "select": "document",
            "customtypes": [
              "course"
            ]
          }
        },
        "course_number": {
          "type": "Text",
          "config": {
            "label": "Item Number (e.g. 01, 02 - Optional override)",
            "placeholder": "Auto: 01, 02..."
          }
        },
        "custom_title": {
          "type": "Text",
          "config": {
            "label": "Custom Title (Optional override)",
            "placeholder": "Leave empty to use course title"
          }
        },
        "custom_description": {
          "type": "Text",
          "config": {
            "label": "Custom Description (Optional override)",
            "placeholder": "Leave empty to use course summary"
          }
        },
        "custom_image": {
          "type": "Image",
          "config": {
            "label": "Custom Badge Image (Optional override)",
            "constraint": {},
            "thumbnails": []
          }
        }
      }
    }
  ]
}
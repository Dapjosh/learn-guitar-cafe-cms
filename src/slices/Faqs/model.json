{
  "id": "faqs",
  "type": "SharedSlice",
  "name": "Faqs",
  "description": "Faqs",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
          }
        },
        "subtitle": {
          "type": "Text",
          "config": {
            "label": "Subtitle",
            "placeholder": ""
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Body",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
          }
        },
        "faqs": {
          "type": "Group",
          "config": {
            "label": "FAQs",
            "repeat": true,
            "fields": {
              "faq": {
                "type": "Link",
                "config": {
                  "label": "FAQ",
                  "select": "document",
                  "customtypes": [
                    "faq"
                  ]
                }
              }
            }
          }
        }
      },
      "items": {}
    },
    {
      "id": "withImage",
      "name": "With Image",
      "docURL": "...",
      "version": "initial",
      "description": "Title, intro, image and button beside an accordion of questions",
      "imageUrl": "",
      "primary": {
        "badge_text": {
          "type": "Text",
          "config": {
            "label": "Badge Text",
            "placeholder": "Help"
          }
        },
        "badge_icon_preset": {
          "type": "Select",
          "config": {
            "label": "Badge Icon",
            "placeholder": "",
            "default_value": "Dot",
            "options": [
              "Dot",
              "Trophy",
              "Star",
              "Music",
              "None"
            ]
          }
        },
        "badge_icon": {
          "type": "Image",
          "config": {
            "label": "Badge Icon Image (optional)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "badge_bg_color": {
          "type": "Color",
          "config": {
            "label": "Badge Background",
            "placeholder": "#ffffff"
          }
        },
        "badge_text_color": {
          "type": "Color",
          "config": {
            "label": "Badge Text Color",
            "placeholder": "#d85d18"
          }
        },
        "badge_icon_color": {
          "type": "Color",
          "config": {
            "label": "Badge Icon Color",
            "placeholder": ""
          }
        },
        "badge_border_color": {
          "type": "Color",
          "config": {
            "label": "Badge Border",
            "placeholder": "transparent"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "single": "heading2,heading1",
            "label": "Title"
          }
        },
        "title_font": {
          "type": "Select",
          "config": {
            "label": "Title Font",
            "placeholder": "",
            "default_value": "Bebas Neue",
            "options": [
              "Bebas Neue",
              "Inter Tight",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "title_size": {
          "type": "Select",
          "config": {
            "label": "Title Size",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "Extra Large",
              "Medium",
              "Small"
            ]
          }
        },
        "title_color": {
          "type": "Color",
          "config": {
            "label": "Title Color",
            "placeholder": "#1c1917"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "multi": "paragraph,strong,em,hyperlink",
            "label": "Intro Text"
          }
        },
        "description_font": {
          "type": "Select",
          "config": {
            "label": "Intro Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "description_size": {
          "type": "Select",
          "config": {
            "label": "Intro Size",
            "placeholder": "",
            "default_value": "Medium",
            "options": [
              "Medium",
              "Small",
              "Large"
            ]
          }
        },
        "description_color": {
          "type": "Color",
          "config": {
            "label": "Intro Color",
            "placeholder": "#78716c"
          }
        },
        "questions": {
          "type": "Group",
          "config": {
            "label": "Questions (type them here, or link an FAQ document)",
            "repeat": true,
            "fields": {
              "faq": {
                "type": "Link",
                "config": {
                  "label": "FAQ Document (optional)",
                  "select": "document",
                  "customtypes": [
                    "faq"
                  ]
                }
              },
              "question": {
                "type": "Text",
                "config": {
                  "label": "Question (overrides the FAQ document's heading)",
                  "placeholder": "What kind of guitar do I need to start?"
                }
              },
              "answer": {
                "type": "StructuredText",
                "config": {
                  "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
                  "label": "Answer (overrides the FAQ document's body)"
                }
              }
            }
          }
        },
        "open_behaviour": {
          "type": "Select",
          "config": {
            "label": "Opening Behaviour",
            "placeholder": "",
            "default_value": "First open, one at a time",
            "options": [
              "First open, one at a time",
              "All closed, one at a time",
              "First open, several at once",
              "All closed, several at once"
            ]
          }
        },
        "add_faq_schema": {
          "type": "Boolean",
          "config": {
            "label": "Add FAQ Structured Data for Google",
            "default_value": true,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        },
        "question_font": {
          "type": "Select",
          "config": {
            "label": "Question Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "question_color": {
          "type": "Color",
          "config": {
            "label": "Question Color",
            "placeholder": "#1c1917"
          }
        },
        "answer_color": {
          "type": "Color",
          "config": {
            "label": "Answer Color",
            "placeholder": "#78716c"
          }
        },
        "open_item_bg_color": {
          "type": "Color",
          "config": {
            "label": "Open Question Background",
            "placeholder": "#fbf9f5"
          }
        },
        "divider_color": {
          "type": "Color",
          "config": {
            "label": "Divider Color",
            "placeholder": "#e2d9cb"
          }
        },
        "icon_color": {
          "type": "Color",
          "config": {
            "label": "Arrow Color",
            "placeholder": "#1c1917"
          }
        },
        "icon_open_color": {
          "type": "Color",
          "config": {
            "label": "Arrow Color (open)",
            "placeholder": "#d85d18"
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "Image & Title Side (desktop)",
            "placeholder": "",
            "default_value": "Left",
            "options": [
              "Left",
              "Right"
            ]
          }
        },
        "image_aspect_ratio": {
          "type": "Select",
          "config": {
            "label": "Image Shape",
            "placeholder": "",
            "default_value": "Landscape",
            "options": [
              "Landscape",
              "Square",
              "Portrait",
              "Wide",
              "Original"
            ]
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Buttons (under the image)",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "Still have a question? Contact Paul"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link",
                  "placeholder": "/contact",
                  "select": null,
                  "allowTargetBlank": true
                }
              },
              "style": {
                "type": "Select",
                "config": {
                  "label": "Style",
                  "placeholder": "",
                  "default_value": "Filled",
                  "options": [
                    "Filled",
                    "Outline"
                  ]
                }
              },
              "show_arrow": {
                "type": "Boolean",
                "config": {
                  "label": "Show Arrow",
                  "default_value": false,
                  "placeholder_true": "Yes",
                  "placeholder_false": "No"
                }
              }
            }
          }
        },
        "button_font": {
          "type": "Select",
          "config": {
            "label": "Button Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "button_radius": {
          "type": "Select",
          "config": {
            "label": "Button Corners",
            "placeholder": "",
            "default_value": "Rounded (Medium)",
            "options": [
              "Rounded (Medium)",
              "Slightly Rounded (Small)",
              "Large Rounded",
              "Pill",
              "Sharp"
            ]
          }
        },
        "button_bg_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Background",
            "placeholder": "#1c1917"
          }
        },
        "button_text_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Text",
            "placeholder": "#ffffff"
          }
        },
        "button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Hover Background",
            "placeholder": "#d85d18"
          }
        },
        "button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Hover Text",
            "placeholder": "#ffffff"
          }
        },
        "outline_button_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Color",
            "placeholder": "#1c1917"
          }
        },
        "outline_button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Hover Background",
            "placeholder": "#1c1917"
          }
        },
        "outline_button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Hover Text",
            "placeholder": "#ffffff"
          }
        },
        "section_bg_color": {
          "type": "Color",
          "config": {
            "label": "Section Background",
            "placeholder": "#f3efe6"
          }
        },
        "padding_top": {
          "type": "Select",
          "config": {
            "label": "Space Above",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_bottom": {
          "type": "Select",
          "config": {
            "label": "Space Below",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_top_custom": {
          "type": "Number",
          "config": {
            "label": "Space Above in px (optional)",
            "placeholder": ""
          }
        },
        "padding_bottom_custom": {
          "type": "Number",
          "config": {
            "label": "Space Below in px (optional)",
            "placeholder": ""
          }
        }
      },
      "items": {}
    }
  ]
}

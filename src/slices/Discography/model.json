{
  "id": "discography",
  "type": "SharedSlice",
  "name": "Discography",
  "description": "Album covers with vinyl, titles and credits, centred header and streaming buttons",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Album grid",
      "imageUrl": "",
      "primary": {
        "badge_text": {
          "type": "Text",
          "config": {
            "label": "Badge Text",
            "placeholder": "Prize winner, John Lennon Songwriting Contest"
          }
        },
        "badge_icon_preset": {
          "type": "Select",
          "config": {
            "label": "Badge Icon",
            "placeholder": "",
            "default_value": "Trophy",
            "options": [
              "Trophy",
              "Dot",
              "Star",
              "Music",
              "None"
            ]
          }
        },
        "badge_icon": {
          "type": "Image",
          "config": {
            "label": "Badge Icon Image (optional - replaces the icon above)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "badge_bg_color": {
          "type": "Color",
          "config": {
            "label": "Badge Background",
            "placeholder": "rgba(255, 255, 255, 0.07)"
          }
        },
        "badge_text_color": {
          "type": "Color",
          "config": {
            "label": "Badge Text Color",
            "placeholder": "#e07b39"
          }
        },
        "badge_icon_color": {
          "type": "Color",
          "config": {
            "label": "Badge Icon Color",
            "placeholder": ""
          }
        },
        "badge_border_color": {
          "type": "Color",
          "config": {
            "label": "Badge Border Color",
            "placeholder": "transparent"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "single": "heading1,heading2",
            "label": "Title"
          }
        },
        "title_font": {
          "type": "Select",
          "config": {
            "label": "Title Font",
            "placeholder": "",
            "default_value": "Bebas Neue",
            "options": [
              "Bebas Neue",
              "Inter Tight",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "title_size": {
          "type": "Select",
          "config": {
            "label": "Title Size",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "Extra Large",
              "Medium",
              "Small"
            ]
          }
        },
        "title_color": {
          "type": "Color",
          "config": {
            "label": "Title Color",
            "placeholder": "#f3efe6"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "multi": "paragraph,strong,em,hyperlink",
            "label": "Description (optional)"
          }
        },
        "header_alignment": {
          "type": "Select",
          "config": {
            "label": "Header Alignment",
            "placeholder": "",
            "default_value": "Center",
            "options": [
              "Center",
              "Left"
            ]
          }
        },
        "albums": {
          "type": "Group",
          "config": {
            "label": "Albums",
            "repeat": true,
            "fields": {
              "cover": {
                "type": "Image",
                "config": {
                  "label": "Cover (square)",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "title": {
                "type": "Text",
                "config": {
                  "label": "Title",
                  "placeholder": "Lonesome Slide"
                }
              },
              "meta": {
                "type": "Text",
                "config": {
                  "label": "Credits / Meta",
                  "placeholder": "Original release · Producer & guitar"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link (optional - e.g. Spotify album)",
                  "placeholder": "",
                  "select": null,
                  "allowTargetBlank": true
                }
              }
            }
          }
        },
        "columns": {
          "type": "Select",
          "config": {
            "label": "Albums per Row (desktop)",
            "placeholder": "",
            "default_value": "4",
            "options": [
              "4",
              "3",
              "5"
            ]
          }
        },
        "show_vinyl": {
          "type": "Boolean",
          "config": {
            "label": "Show Vinyl Behind Covers",
            "default_value": true,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        },
        "album_title_font": {
          "type": "Select",
          "config": {
            "label": "Album Title Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "album_title_color": {
          "type": "Color",
          "config": {
            "label": "Album Title Color",
            "placeholder": "#f3efe6"
          }
        },
        "meta_color": {
          "type": "Color",
          "config": {
            "label": "Credits / Description Color",
            "placeholder": "#a8a29e"
          }
        },
        "cover_border_color": {
          "type": "Color",
          "config": {
            "label": "Cover Border Color",
            "placeholder": "transparent"
          }
        },
        "vinyl_color": {
          "type": "Color",
          "config": {
            "label": "Vinyl Color",
            "placeholder": "#151210"
          }
        },
        "vinyl_groove_color": {
          "type": "Color",
          "config": {
            "label": "Vinyl Groove Color",
            "placeholder": "rgba(255, 255, 255, 0.07)"
          }
        },
        "vinyl_label_color": {
          "type": "Color",
          "config": {
            "label": "Vinyl Label Color",
            "placeholder": "#d85d18"
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Buttons",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "Contact Paul"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link",
                  "placeholder": "",
                  "select": null,
                  "allowTargetBlank": true
                }
              },
              "style": {
                "type": "Select",
                "config": {
                  "label": "Style",
                  "placeholder": "",
                  "default_value": "Filled",
                  "options": [
                    "Filled",
                    "Outline"
                  ]
                }
              },
              "show_arrow": {
                "type": "Boolean",
                "config": {
                  "label": "Show Arrow",
                  "default_value": false,
                  "placeholder_true": "Yes",
                  "placeholder_false": "No"
                }
              }
            }
          }
        },
        "button_font": {
          "type": "Select",
          "config": {
            "label": "Button Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "button_radius": {
          "type": "Select",
          "config": {
            "label": "Button Corners",
            "placeholder": "",
            "default_value": "Rounded (Medium)",
            "options": [
              "Rounded (Medium)",
              "Slightly Rounded (Small)",
              "Large Rounded",
              "Pill",
              "Sharp"
            ]
          }
        },
        "button_bg_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Background",
            "placeholder": "#f3efe6"
          }
        },
        "button_text_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Text",
            "placeholder": "#1c1917"
          }
        },
        "button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Hover Background",
            "placeholder": "#d85d18"
          }
        },
        "button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Hover Text",
            "placeholder": "#ffffff"
          }
        },
        "outline_button_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Color",
            "placeholder": "#f3efe6"
          }
        },
        "outline_button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Hover Background",
            "placeholder": "#f3efe6"
          }
        },
        "outline_button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Hover Text",
            "placeholder": "#1c1917"
          }
        },
        "section_bg_color": {
          "type": "Color",
          "config": {
            "label": "Section Background",
            "placeholder": "#1c1917"
          }
        },
        "padding_top": {
          "type": "Select",
          "config": {
            "label": "Space Above",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_bottom": {
          "type": "Select",
          "config": {
            "label": "Space Below",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_top_custom": {
          "type": "Number",
          "config": {
            "label": "Space Above in px (optional)",
            "placeholder": ""
          }
        },
        "padding_bottom_custom": {
          "type": "Number",
          "config": {
            "label": "Space Below in px (optional)",
            "placeholder": ""
          }
        }
      },
      "items": {}
    }
  ]
}
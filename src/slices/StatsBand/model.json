        },
        "value_font": {
          "type": "Select",
          "config": {
            "label": "Stat Number Font",
            "placeholder": "",
            "default_value": "Bebas Neue",
            "options": [
              "Bebas Neue",
              "Anton",
              "Fraunces",
              "Inter Tight",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One"
            ]
          }
        },
        "value_size": {
          "type": "Select",
          "config": {
            "label": "Stat Number Size",
            "placeholder": "",
            "default_value": "Large",
            "options": ["Large", "Extra Large", "Medium", "Small"]
          }
        },
        "value_color": {
          "type": "Color",
          "config": {
            "label": "Stat Number Color",
            "placeholder": "#e07b39"
          }
        },
        "label_font": {
          "type": "Select",
          "config": {
            "label": "Stat Label Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Inter",
              "Fraunces",
              "Bebas Neue",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "label_color": {
          "type": "Color",
          "config": {
            "label": "Stat Label Color",
            "placeholder": "#f5f5f4"
          }
        },
        "animate_numbers": {
          "type": "Boolean",
          "config": {
            "label": "Animate numbers (count up when scrolled into view)",
            "default_value": true,
            "placeholder_true": "Animate",
            "placeholder_false": "Static"
          }
        },
        "stats": {
          "type": "Group",
          "config": {
            "label": "Statistics",
            "repeat": true,
            "fields": {
              "value": {
                "type": "Text",
                "config": {
                  "label": "Value (e.g. 2,500+ or $1.5M)",
                  "placeholder": "2,500+"
                }
              },
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "Active players"
                }
              }
            }
          }
        }
      },
      "items": {}
    }

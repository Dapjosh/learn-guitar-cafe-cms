        "badge_icon": {
          "type": "Image",
          "config": {
            "label": "Badge Icon (Upload Icon Image)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "badge_text": {
          "type": "Text",
          "config": {
            "label": "Badge Text",
            "placeholder": "Community"
          }
        },
        "badge_bg_color": {
          "type": "Color",
          "config": {
            "label": "Badge Background Color",
            "placeholder": "#ffffff"
          }
        },
        "badge_color": {
          "type": "Color",
          "config": {
            "label": "Badge Text & Icon Color",
            "placeholder": "#d85d18"
          }
        },
        "badge_border_color": {
          "type": "Color",
          "config": {
            "label": "Badge Border Color",
            "placeholder": "transparent"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "single": "heading2,heading1,strong,em",
            "label": "Heading Title"
          }
        },
        "title_font": {
          "type": "Select",
          "config": {
            "label": "Heading Font",
            "placeholder": "",
            "default_value": "Bebas Neue",
            "options": [
              "Bebas Neue",
              "Fraunces",
              "Inter Tight",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "title_size": {
          "type": "Select",
          "config": {
            "label": "Heading Size",
            "placeholder": "",
            "default_value": "Large",
            "options": ["Large", "Extra Large", "Medium", "Small"]
          }
        },
        "title_color": {
          "type": "Color",
          "config": {
            "label": "Heading Color",
            "placeholder": "#1c1917"
          }

        "section_bg_color": {
          "type": "Color",
          "config": {
            "label": "Section Background Color",
            "placeholder": "#f3efe6"
          }
        },
        "panel_bg_color": {
          "type": "Color",
          "config": {
            "label": "Stats Panel Background Color",
            "placeholder": "#1c1917"
          }

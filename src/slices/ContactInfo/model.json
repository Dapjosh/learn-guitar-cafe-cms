{
  "id": "contact_info",
  "type": "SharedSlice",
  "name": "ContactInfo",
  "description": "Centred header with contact cards (email, phone, social links...)",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Header + contact cards",
      "imageUrl": "",
      "primary": {
        "badge_text": {
          "type": "Text",
          "config": {
            "label": "Badge Text",
            "placeholder": "Get in touch"
          }
        },
        "badge_icon_preset": {
          "type": "Select",
          "config": {
            "label": "Badge Icon",
            "placeholder": "",
            "default_value": "Dot",
            "options": [
              "Dot",
              "Trophy",
              "Star",
              "Music",
              "None"
            ]
          }
        },
        "badge_icon": {
          "type": "Image",
          "config": {
            "label": "Badge Icon Image (optional)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "badge_bg_color": {
          "type": "Color",
          "config": {
            "label": "Badge Background",
            "placeholder": "#ffffff"
          }
        },
        "badge_text_color": {
          "type": "Color",
          "config": {
            "label": "Badge Text Color",
            "placeholder": "#d85d18"
          }
        },
        "badge_icon_color": {
          "type": "Color",
          "config": {
            "label": "Badge Icon Color",
            "placeholder": ""
          }
        },
        "badge_border_color": {
          "type": "Color",
          "config": {
            "label": "Badge Border",
            "placeholder": "transparent"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "single": "heading1,heading2",
            "label": "Title"
          }
        },
        "title_font": {
          "type": "Select",
          "config": {
            "label": "Title Font",
            "placeholder": "",
            "default_value": "Bebas Neue",
            "options": [
              "Bebas Neue",
              "Inter Tight",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "title_size": {
          "type": "Select",
          "config": {
            "label": "Title Size",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "Extra Large",
              "Medium",
              "Small"
            ]
          }
        },
        "title_color": {
          "type": "Color",
          "config": {
            "label": "Title Color",
            "placeholder": "#1c1917"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "multi": "paragraph,strong,em,hyperlink",
            "label": "Description"
          }
        },
        "description_color": {
          "type": "Color",
          "config": {
            "label": "Description Color",
            "placeholder": "#78716c"
          }
        },
        "header_alignment": {
          "type": "Select",
          "config": {
            "label": "Header Alignment",
            "placeholder": "",
            "default_value": "Center",
            "options": [
              "Center",
              "Left"
            ]
          }
        },
        "cards": {
          "type": "Group",
          "config": {
            "label": "Cards",
            "repeat": true,
            "fields": {
              "icon": {
                "type": "Select",
                "config": {
                  "label": "Icon",
                  "placeholder": "",
                  "default_value": "Email",
                  "options": [
                    "Email",
                    "Community",
                    "Phone",
                    "Location",
                    "Calendar",
                    "Link"
                  ]
                }
              },
              "title": {
                "type": "Text",
                "config": {
                  "label": "Title",
                  "placeholder": "Email"
                }
              },
              "text": {
                "type": "Text",
                "config": {
                  "label": "Text (optional)",
                  "placeholder": ""
                }
              },
              "email": {
                "type": "Text",
                "config": {
                  "label": "Email Address (optional - becomes a mailto link)",
                  "placeholder": "paul@learnguitarcafe.com"
                }
              },
              "phone": {
                "type": "Text",
                "config": {
                  "label": "Phone Number (optional - becomes a call link)",
                  "placeholder": ""
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link (optional)",
                  "placeholder": "",
                  "select": null,
                  "allowTargetBlank": true
                }
              },
              "link_label": {
                "type": "Text",
                "config": {
                  "label": "Link Label",
                  "placeholder": "Learn more"
                }
              },
              "show_social": {
                "type": "Boolean",
                "config": {
                  "label": "Show Social Icons (from the list below)",
                  "default_value": false,
                  "placeholder_true": "Yes",
                  "placeholder_false": "No"
                }
              }
            }
          }
        },
        "social_links": {
          "type": "Group",
          "config": {
            "label": "Social Links",
            "repeat": true,
            "fields": {
              "platform": {
                "type": "Select",
                "config": {
                  "label": "Platform",
                  "placeholder": "",
                  "default_value": "YouTube",
                  "options": [
                    "YouTube",
                    "Instagram",
                    "Facebook",
                    "X",
                    "TikTok",
                    "Spotify",
                    "Website"
                  ]
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link",
                  "placeholder": "",
                  "select": null,
                  "allowTargetBlank": true
                }
              }
            }
          }
        },
        "card_title_font": {
          "type": "Select",
          "config": {
            "label": "Card Title Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "card_bg_color": {
          "type": "Color",
          "config": {
            "label": "Card Background",
            "placeholder": "#fbf9f5"
          }
        },
        "card_border_color": {
          "type": "Color",
          "config": {
            "label": "Card Border",
            "placeholder": "#e2d9cb"
          }
        },
        "icon_bg_color": {
          "type": "Color",
          "config": {
            "label": "Icon Circle Background",
            "placeholder": "#f8d5c0"
          }
        },
        "icon_color": {
          "type": "Color",
          "config": {
            "label": "Icon Color",
            "placeholder": "#d85d18"
          }
        },
        "card_title_color": {
          "type": "Color",
          "config": {
            "label": "Card Title Color",
            "placeholder": "#1c1917"
          }
        },
        "card_text_color": {
          "type": "Color",
          "config": {
            "label": "Card Text Color",
            "placeholder": "#57534e"
          }
        },
        "link_color": {
          "type": "Color",
          "config": {
            "label": "Link / Email Color",
            "placeholder": "#d85d18"
          }
        },
        "social_icon_color": {
          "type": "Color",
          "config": {
            "label": "Social Icon Color",
            "placeholder": "#1c1917"
          }
        },
        "social_icon_hover_color": {
          "type": "Color",
          "config": {
            "label": "Social Icon Hover Color",
            "placeholder": "#d85d18"
          }
        },
        "section_bg_color": {
          "type": "Color",
          "config": {
            "label": "Section Background",
            "placeholder": "#f3efe6"
          }
        },
        "padding_top": {
          "type": "Select",
          "config": {
            "label": "Space Above",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_bottom": {
          "type": "Select",
          "config": {
            "label": "Space Below",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_top_custom": {
          "type": "Number",
          "config": {
            "label": "Space Above in px (optional)",
            "placeholder": ""
          }
        },
        "padding_bottom_custom": {
          "type": "Number",
          "config": {
            "label": "Space Below in px (optional)",
            "placeholder": ""
          }
        }
      },
      "items": {}
    }
  ]
}

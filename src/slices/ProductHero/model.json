{
  "id": "product_hero",
  "type": "SharedSlice",
  "name": "ProductHero",
  "description": "Product landing hero: title, checklist, product image with optional vinyl record, and buttons (use the Lead Form slice for the sign-up form)",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Product hero",
      "imageUrl": "",
      "primary": {
        "badge_text": {
          "type": "Text",
          "config": {
            "label": "Badge Text",
            "placeholder": "Free lesson pack"
          }
        },
        "badge_icon_preset": {
          "type": "Select",
          "config": {
            "label": "Badge Icon",
            "placeholder": "",
            "default_value": "Dot",
            "options": [
              "Dot",
              "Trophy",
              "Star",
              "Music",
              "None"
            ]
          }
        },
        "badge_icon": {
          "type": "Image",
          "config": {
            "label": "Badge Icon Image (optional)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "badge_bg_color": {
          "type": "Color",
          "config": {
            "label": "Badge Background",
            "placeholder": "rgba(216, 93, 24, 0.16)"
          }
        },
        "badge_text_color": {
          "type": "Color",
          "config": {
            "label": "Badge Text Color",
            "placeholder": "#e07b39"
          }
        },
        "badge_icon_color": {
          "type": "Color",
          "config": {
            "label": "Badge Icon Color",
            "placeholder": ""
          }
        },
        "badge_border_color": {
          "type": "Color",
          "config": {
            "label": "Badge Border",
            "placeholder": "transparent"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "single": "heading1,heading2",
            "label": "Title"
          }
        },
        "title_font": {
          "type": "Select",
          "config": {
            "label": "Title Font",
            "placeholder": "",
            "default_value": "Bebas Neue",
            "options": [
              "Bebas Neue",
              "Inter Tight",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "title_size": {
          "type": "Select",
          "config": {
            "label": "Title Size",
            "placeholder": "",
            "default_value": "Extra Large",
            "options": [
              "Extra Large",
              "Large",
              "Medium",
              "Small"
            ]
          }
        },
        "title_color": {
          "type": "Color",
          "config": {
            "label": "Title Color",
            "placeholder": "#f3efe6"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "multi": "paragraph,strong,em,hyperlink",
            "label": "Intro"
          }
        },
        "description_font": {
          "type": "Select",
          "config": {
            "label": "Intro Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "description_size": {
          "type": "Select",
          "config": {
            "label": "Intro Size",
            "placeholder": "",
            "default_value": "Medium",
            "options": [
              "Medium",
              "Small",
              "Large"
            ]
          }
        },
        "description_color": {
          "type": "Color",
          "config": {
            "label": "Intro Color",
            "placeholder": "#a8a29e"
          }
        },
        "checklist": {
          "type": "Group",
          "config": {
            "label": "Checklist",
            "repeat": true,
            "fields": {
              "text": {
                "type": "Text",
                "config": {
                  "label": "Item",
                  "placeholder": "Complete video breakdown of the classic slide tune"
                }
              }
            }
          }
        },
        "checklist_text_color": {
          "type": "Color",
          "config": {
            "label": "Checklist Text Color",
            "placeholder": "#f3efe6"
          }
        },
        "check_bg_color": {
          "type": "Color",
          "config": {
            "label": "Check Icon Background",
            "placeholder": "rgba(216, 93, 24, 0.16)"
          }
        },
        "check_color": {
          "type": "Color",
          "config": {
            "label": "Check Icon Color",
            "placeholder": "#e07b39"
          }
        },
        "product_image": {
          "type": "Image",
          "config": {
            "label": "Product Image (transparent PNG works best, e.g. the book mockup)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "Product Image Side (desktop)",
            "placeholder": "",
            "default_value": "Left",
            "options": [
              "Left",
              "Right"
            ]
          }
        },
        "show_vinyl": {
          "type": "Boolean",
          "config": {
            "label": "Show Vinyl Record Behind Product",
            "default_value": true,
            "placeholder_true": "Yes",
            "placeholder_false": "No"
          }
        },
        "vinyl_label_text": {
          "type": "Text",
          "config": {
            "label": "Vinyl Label Text",
            "placeholder": "Learn Guitar Cafe"
          }
        },
        "vinyl_label_subtext": {
          "type": "Text",
          "config": {
            "label": "Vinyl Label Small Text",
            "placeholder": "Side A · 33⅓"
          }
        },
        "vinyl_color": {
          "type": "Color",
          "config": {
            "label": "Vinyl Color",
            "placeholder": "#1c1917"
          }
        },
        "vinyl_groove_color": {
          "type": "Color",
          "config": {
            "label": "Vinyl Groove Color",
            "placeholder": "rgba(216, 93, 24, 0.55)"
          }
        },
        "vinyl_label_color": {
          "type": "Color",
          "config": {
            "label": "Vinyl Label Color",
            "placeholder": "#d85d18"
          }
        },
        "vinyl_label_text_color": {
          "type": "Color",
          "config": {
            "label": "Vinyl Label Text Color",
            "placeholder": "#fbe3d4"
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Hero Buttons (optional, e.g. 'Get it free' → #get-the-lesson)",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label",
                  "placeholder": "Get it free"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link",
                  "placeholder": "#get-the-lesson",
                  "select": null,
                  "allowTargetBlank": true
                }
              },
              "style": {
                "type": "Select",
                "config": {
                  "label": "Style",
                  "placeholder": "",
                  "default_value": "Filled",
                  "options": [
                    "Filled",
                    "Outline"
                  ]
                }
              },
              "show_arrow": {
                "type": "Boolean",
                "config": {
                  "label": "Show Arrow",
                  "default_value": false,
                  "placeholder_true": "Yes",
                  "placeholder_false": "No"
                }
              }
            }
          }
        },
        "button_font": {
          "type": "Select",
          "config": {
            "label": "Button Font",
            "placeholder": "",
            "default_value": "Inter Tight",
            "options": [
              "Inter Tight",
              "Bebas Neue",
              "Fraunces",
              "Inter",
              "Raleway",
              "Nunito",
              "Mochiy Pop One",
              "Anton"
            ]
          }
        },
        "button_radius": {
          "type": "Select",
          "config": {
            "label": "Button Corners",
            "placeholder": "",
            "default_value": "Rounded (Medium)",
            "options": [
              "Rounded (Medium)",
              "Slightly Rounded (Small)",
              "Large Rounded",
              "Pill",
              "Sharp"
            ]
          }
        },
        "button_bg_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Background",
            "placeholder": "#d85d18"
          }
        },
        "button_text_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Text",
            "placeholder": "#ffffff"
          }
        },
        "button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Hover Background",
            "placeholder": "#b94c10"
          }
        },
        "button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Filled Button Hover Text",
            "placeholder": "#ffffff"
          }
        },
        "outline_button_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Color",
            "placeholder": "#f3efe6"
          }
        },
        "outline_button_hover_bg_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Hover Background",
            "placeholder": "#f3efe6"
          }
        },
        "outline_button_hover_text_color": {
          "type": "Color",
          "config": {
            "label": "Outline Button Hover Text",
            "placeholder": "#1c1917"
          }
        },
        "hero_bg_color": {
          "type": "Color",
          "config": {
            "label": "Hero Background",
            "placeholder": "#1c1917"
          }
        },
        "padding_top": {
          "type": "Select",
          "config": {
            "label": "Space Above",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_bottom": {
          "type": "Select",
          "config": {
            "label": "Space Below",
            "placeholder": "",
            "default_value": "Large",
            "options": [
              "Large",
              "None",
              "Small",
              "Medium",
              "Extra Large"
            ]
          }
        },
        "padding_top_custom": {
          "type": "Number",
          "config": {
            "label": "Space Above in px (optional)",
            "placeholder": ""
          }
        },
        "padding_bottom_custom": {
          "type": "Number",
          "config": {
            "label": "Space Below in px (optional)",
            "placeholder": ""
          }
        }
      },
      "items": {}
    }
  ]
}
